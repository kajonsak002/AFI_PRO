{
  "manifest_version": 3,
  "name": "RUAYRUAY Studio — TikTok Affiliate Showcase & Auto-Video",
  "version": "2.0.0",
  "description": "TikTok Affiliate Showcase & AI Auto-Video Studio with Glassmorphism Console",
  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "alarms",
    "tabs",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://*.tiktok.com/*",
    "https://*.tiktokshop.com/*",
    "https://*.tiktokglobalshop.com/*",
    "https://*.tiktokcdn.com/*",
    "https://*.byteimg.com/*",
    "https://*.ibyteimg.com/*",
    "https://*.ibytedtos.com/*",
    "https://meta.ai/*",
    "https://www.meta.ai/*",
    "https://labs.google/*",
    "https://flow.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://api.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "RUAYRUAY Studio",
    "default_icon": "icons/icon.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
